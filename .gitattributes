# Normalize all text files to LF in the repo and the working tree. Windows
# checkouts run core.autocrlf=true, which makes the working copy CRLF while the
# index stays LF; that desync makes biome report phantom CRLF format errors and
# shifts the AST line numbers the no-floating-promises gate reports. Pinning LF
# everywhere removes both.
* text=auto eol=lf

# Generated lockfiles: text (LF-normalized) but never diffed or hand-edited.
bun.lock        linguist-generated -diff
shell/bun.lock  linguist-generated -diff
ui/bun.lock     linguist-generated -diff
