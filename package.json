{
  "name": "hive",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun test",
    "test:manifest-interop": "bun run scripts/test-cross-repo-manifest-lock.ts",
    "check": "biome check",
    "check:no-float": "bun run scripts/check-no-floating-suppressions.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run check:no-float && bun run check && bun run typecheck && bun run test",
    "format": "biome format --write",
    "dev:full": "bun run scripts/dev.ts",
    "screenshot": "bun run scripts/screenshot.ts",
    "ship": "bun run scripts/ship.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.49.0",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
